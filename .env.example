# discord developer portal → your app → bot → token
DISCORD_TOKEN=
# railway sets this automatically when you add a postgres service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stash
# optional: register slash commands to one server instantly while developing
DEV_GUILD_ID=
LOG_LEVEL=INFO
# optional: discord webhook for the host's private #alerts channel (failed drops in any server)
ALERT_WEBHOOK_URL=
# encrypts each server's claude key (/setkey). generate once and keep it: losing it means re-entering every key
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STASH_SECRET_KEY=
