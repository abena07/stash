# discord developer portal → your app → bot → token
DISCORD_TOKEN=
# railway sets this when you add a postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stash
# development only: register slash commands to one test server instantly. leave unset in production
DEV_GUILD_ID=
LOG_LEVEL=INFO
# optional: discord webhook where the host hears about failed drops in any server
ALERT_WEBHOOK_URL=
# encrypts the ai keys servers add with /setkey. generate once and keep it safe (losing it means
# every server re-enters its key):  openssl rand -base64 32 | tr '+/' '-_'
STASH_SECRET_KEY=
# serve the obsidian plugin api on this port. railway sets it for you; locally e.g. 8787
PORT=
